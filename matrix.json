{
  "power": true,
  "brightness": 50,
  "schedule": [
    {
      "screen": "weather",
      "at": "0 */15 * * * *",
      "for": 15
    },
    {
      "screen": "markets",
      "at": "15 */15 * * * *",
      "for": 15
    },
    {
      "screen": "subway"
    }
  ],
  "screens": {
    "markets": {
      "sources": {
        "/market": {
          "symbol": "SPY",
          "range": "3day",
          "label": "SPY"
        }
      }
    }
  },
  "sleep": {
    "weekday": {
      "start": "23:30",
      "end": "05:30"
    },
    "weekend": {
      "start": "00:00",
      "end": "08:00"
    }
  }
}
